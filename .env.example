# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/intake?schema=public"

# ---------------------------------------------------------------------------
# Anthropic API — extraction, question generation, rendering
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
# Optional override. Defaults to claude-opus-5.
INTAKE_MODEL="claude-opus-5"

# ---------------------------------------------------------------------------
# Artifact storage
#
# Decided in config per deployment, BEFORE a share link is sent to a customer.
# See docs/DECISIONS.md (D2). Nothing in the app picks a storage location at
# runtime; if this is not set the app refuses to accept an upload.
#
#   local  — local blob: a directory on the app host. Good for dev and for
#            on-prem deployments where artifacts may not leave the box.
#   s3     — cloud blob: any S3-compatible bucket (AWS, R2, MinIO, Wasabi).
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"

# STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT="./storage"

# STORAGE_DRIVER=s3
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION=""
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
# Path-style addressing, required by MinIO and some S3-compatible providers.
STORAGE_S3_FORCE_PATH_STYLE="false"

# Raw-artifact retention, in days. Derived claims are retained; raw artifact
# bytes and text are eligible for hard delete after this window.
# Empty means "retain indefinitely" and must be a deliberate choice.
ARTIFACT_RETENTION_DAYS="90"

# ---------------------------------------------------------------------------
# Ingest policy
#
# Audio ingest is OFF in v1 and must stay off until the third-party consent
# question is answered by legal. See docs/DECISIONS.md (D3).
# ---------------------------------------------------------------------------
INGEST_AUDIO_ENABLED="false"

# ---------------------------------------------------------------------------
# Voice (Phase 2 — not implemented in Phase 1)
#
# Target budget is <800ms from the exec finishing to the next question
# starting, interruptible. See docs/DECISIONS.md (D1).
# ---------------------------------------------------------------------------
VOICE_DRIVER="none"
VOICE_TURN_BUDGET_MS="800"

# ---------------------------------------------------------------------------
# Share links
# ---------------------------------------------------------------------------
# Base URL used to build the link an Antz team member sends to a customer.
APP_BASE_URL="http://localhost:3000"
# Days before an unused share link expires. Empty means no expiry.
SHARE_LINK_TTL_DAYS="30"
