# ──────────────────────────────────────────────────────────────────────────
# Vidur environment — copy to .env.local and fill in. NEVER commit .env.local.
# Secrets are server-only; nothing here is exposed to the browser.
# ──────────────────────────────────────────────────────────────────────────

# Auth.js (NextAuth v5) ------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# One-click dev sign-in. When "true" (default in dev), a "Sign in as CEO"
# button is available so the local demo needs no real identity provider.
# Set to "false" in any shared/staging/production environment.
AUTH_DEV_MODE=true

# Microsoft Entra ID (OAuth provider for v1) ---------------------------------
# Leave blank in pure-local dev; required for real sign-in.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# gbrain (memory layer) — wired in Phase 1 -----------------------------------
# gbrain serve --http  (OAuth 2.1 + scopes read/write/admin)
GBRAIN_HTTP_URL=http://localhost:8787
GBRAIN_SERVICE_TOKEN=

# Model + embeddings — surfaced on the Govern > Config page (Phase 1+) --------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
# Embedding + reranker provider: zeroentropy | openai | voyage
EMBEDDING_PROVIDER=zeroentropy
ZEROENTROPY_API_KEY=

# Database (team brain = Postgres + pgvector; Azure Database for PostgreSQL) --
DATABASE_URL=
